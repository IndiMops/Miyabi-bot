# Copy to .env and fill in. Never commit .env.

# --- Bot ---
DISCORD_BOT_TOKEN=<your-bot-token>
DEBUG=False

# --- Status heartbeat (shared by the bot and status_service) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STATUS_HEARTBEAT_SECRET=<long-random-secret>
STATUS_SERVICE_NAME=miyabi-bot
STATUS_HEARTBEAT_INTERVAL=30

# --- Bot side: where to send heartbeats (empty = reporter disabled) ---
STATUS_HEARTBEAT_URL=http://127.0.0.1:8787/heartbeat
STATUS_HEARTBEAT_TIMEOUT=5

# --- status_service side ---
STATUS_LISTEN_HOST=127.0.0.1
STATUS_LISTEN_PORT=8787
# Discord webhook of the dedicated status text channel (empty = no publishing)
STATUS_WEBHOOK_URL=
STATUS_DISPLAY_NAME=Miyabi Bot
# Embed thumbnail; empty = bot.assets.avatar from config.json
STATUS_THUMBNAIL_URL=
STATUS_STATE_FILE=data/status_service_state.json
# Only to adopt an existing webhook message if the state file was lost
STATUS_MESSAGE_ID=
STATUS_RECREATE_MISSING_MESSAGE=true
STATUS_OFFLINE_AFTER=90
STATUS_STARTING_GRACE=180
STATUS_DEGRADED_LATENCY_MS=1000
STATUS_EVALUATE_INTERVAL=10
STATUS_PUBLISH_INTERVAL=300
